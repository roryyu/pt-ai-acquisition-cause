  "cards": [
    {
      "dot": "emerald",
      "title": "两条研究路径互补",
      "items": [
        "/ask → Supervisor 三分类：direct（直接流式）/ data_analysis / research（轻量研究+ Critic）",
        "/research → 独立深度研究引擎：Planner 拆解→逐子问题检索深读→多源比对→正式报告",
        "DataAnalyst 不经过 Critic，直接到 Synthesizer；ResearchWorker 必须经 Critic 校验"
      ]
    },
    {
      "dot": "rose",
      "title": "质量与安全护栏",
      "items": [
        "Critic 先硬校验（证据≥2条+引用≥1个）再 LLM 软校验（覆盖度/一致性），不达标重试≤1次",
        "SQL 仅允许 SELECT/WITH，白名单校验禁止写操作，标识符与字符串净化防注入",
        "ResearchWorker 兜底：模型未主动 record_finding 但已有搜索证据时，自动将搜索摘要转正为发现"
      ]
    },
    {
      "dot": "violet",
      "title": "语义统一与算子化",
      "items": [
        "语义模型定义一次，NL2SQL 转译、Agent 数据字典、人工试运行三处同源",
        "12 算子 = 6 数据分析算子(SQL引擎) + 6 研究算子(LLM引擎)，算子优先原则",
        "所有 LLM 调用经统一模型网关主备降级，5 分钟熔断冷却，结果持久化可回溯"
      ]
    }
  ]
