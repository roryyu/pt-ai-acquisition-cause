# ============================================================
# 归因模块 - 环境变量模板
# 复制为 .env 并按环境填写；变量说明见 lib/env.ts 中的 Zod Schema
# ============================================================

# ---------- 应用 ----------
# 运行环境：development / staging / production
APP_ENV=development
APP_URL=http://localhost:3000
# 会话签名密钥（生产环境必须替换，至少 32 字符）
AUTH_SECRET=

# ---------- 统一模型网关（所有 AI 调用必须经过，见 design.md 1.3 / 12.1） ----------
MODEL_GATEWAY_BASE_URL=
MODEL_GATEWAY_API_KEY=
MODEL_GATEWAY_DEFAULT_MODEL=
MODEL_GATEWAY_TIMEOUT_MS=60000

# ---------- PostgreSQL + pgvector（主存储，见 design.md 6.1） ----------
# Prisma 7 统一连接串：CLI（prisma.config.ts 的 migrate/db push/studio）
# 与运行时驱动适配器（lib/db/index.ts 的 @prisma/adapter-pg）共用；
# ?schema= 参数须与 prisma/schema.prisma 的 datasource.schemas 保持一致
DATABASE_URL=postgresql://user:password@localhost:5432/postgres?schema=cause

# ---------- Redis（会话缓存/限流/任务状态锁，见 design.md 6.3） ----------
REDIS_URL=redis://localhost:6379

# ---------- 消息队列（研究任务队列，预留，见 design.md 6.3） ----------
MQ_URL=amqp://localhost:5672

# ---------- MCP Gateway（OAuth2.1，见 design.md 5.1.3） ----------
MCP_GATEWAY_URL=
MCP_GATEWAY_CLIENT_ID=
MCP_GATEWAY_CLIENT_SECRET=

# ---------- Web 抓取 Firecrawl（见 design.md 5.1.4） ----------
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev

# ---------- 对象存储（S3 兼容 / MinIO，见 design.md 6.3） ----------
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_BUCKET=insight

# ---------- Adjust 报告服务 API（见 doc/Adjust官网API与MCP对接指南-20260902.md） ----------
# API 识别码：Adjust 控制面板 → 账户设置 → 个人档案 获取，Bearer Token 认证
ADJUST_API_TOKEN=
ADJUST_RS_API_BASE_URL=https://automate.adjust.com/reports-service
# 报告时区：同步落库与算子 API 直查统一口径（缺省 +08:00；格式 ±HH:MM）
# 注意：变更时区后历史已同步数据口径不同，建议重跑一次较大窗口的同步（如 --days 30）
ADJUST_RS_UTC_OFFSET=+08:00
# 定时同步：无常驻定时器，由外部 cron 驱动（Adjust 数据 T+1，幂等可重跑）：
#   30 9 * * * curl -X POST http://localhost:3000/api/v1/syncs/adjust -d '{"days":3}'
# 手动：npx tsx scripts/sync-adjust-data.ts [--days N]
